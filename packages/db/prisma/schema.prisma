// Schema do Orla — convenções em docs/03-modelo-de-dados.md:
// tabelas/colunas em snake_case (@@map/@map), models em PascalCase,
// IDs uuid v7 gerados na aplicação, dinheiro em centavos (BigInt),
// enums como text + CHECK (as constraints CHECK e os índices parciais ficam no SQL
// da migration, porque o Prisma não os expressa).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Usuários e sessão ──────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// Único, sempre em minúsculas (case-insensitive na prática).
  username     String    @unique
  passwordHash String    @map("password_hash")
  displayName  String?   @map("display_name")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)

  sessions           Session[]
  settings           UserSettings?
  accounts           Account[]
  creditCards        CreditCard[]
  categories         Category[]
  payees             Payee[]
  recurringTemplates RecurringTemplate[]
  installmentPlans   InstallmentPlan[]
  transactions       Transaction[]
  monthSettings      MonthSettings[]
  importJobs         ImportJob[]
  assetClasses       AssetClass[]
  targetAllocations  TargetAllocation[]
  assets             Asset[]
  assetTrades        AssetTrade[]
  dividends          Dividend[]
  feedback           Feedback[]
  contributionPlans  ContributionPlan[]
  contributions      Contribution[]

  @@map("users")
}

model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ip               String?
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Preferências do usuário (docs/03 › user_settings). Uma linha por usuário.
model UserSettings {
  userId                   String    @id @map("user_id") @db.Uuid
  /// Meta padrão de investimento: valor fixo OU % das receitas (só um dos dois).
  defaultSavingsGoalCents  BigInt?   @map("default_savings_goal_cents")
  defaultSavingsGoalPct    Decimal?  @map("default_savings_goal_pct") @db.Decimal(7, 4)
  /// due_month · closing_month
  cardCompetence           String    @default("due_month") @map("card_competence")
  /// end · start · dietz
  contributionTiming       String    @default("end") @map("contribution_timing")
  /// contributions · trades
  returnContributionSource String    @default("contributions") @map("return_contribution_source")
  currency                 String    @default("BRL")
  /// light · dark · system
  theme                    String    @default("system")
  hideValues               Boolean   @default(false) @map("hide_values")
  onboardingCompletedAt    DateTime? @map("onboarding_completed_at") @db.Timestamptz(3)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ─── Cadastros (Fase 1) ─────────────────────────────────────────────────────

/// Instituições/contas: bancos, corretoras, carteira de dinheiro.
model Account {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String
  /// checking · savings · brokerage · wallet · other
  kind       String
  color      String
  isArchived Boolean   @default(false) @map("is_archived")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCards        CreditCard[]
  recurringTemplates RecurringTemplate[]
  installmentPlans   InstallmentPlan[]
  transactions       Transaction[]
  assets             Asset[]

  @@index([userId])
  @@map("accounts")
}

model CreditCard {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// Banco emissor.
  accountId  String    @map("account_id") @db.Uuid
  name       String
  closingDay Int       @map("closing_day") @db.SmallInt
  dueDay     Int       @map("due_day") @db.SmallInt
  limitCents BigInt?   @map("limit_cents")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  account            Account             @relation(fields: [accountId], references: [id])
  recurringTemplates RecurringTemplate[]
  installmentPlans   InstallmentPlan[]
  transactions       Transaction[]

  @@index([userId])
  @@map("credit_cards")
}

/// Categorias de receita/despesa, hierárquicas com 1 nível de subcategoria.
model Category {
  id                 String    @id @default(uuid(7)) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  /// income · expense
  kind               String
  name               String
  parentId           String?   @map("parent_id") @db.Uuid
  /// Nome do ícone (lucide).
  icon               String
  color              String
  monthlyBudgetCents BigInt?   @map("monthly_budget_cents")
  sortOrder          Int       @default(0) @map("sort_order")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent             Category?           @relation("CategoryTree", fields: [parentId], references: [id])
  children           Category[]          @relation("CategoryTree")
  defaultForPayees   Payee[]
  recurringTemplates RecurringTemplate[]
  installmentPlans   InstallmentPlan[]
  transactions       Transaction[]

  @@index([userId, kind])
  @@map("categories")
}

/// Estabelecimentos / quem pagou / quem recebeu.
model Payee {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  name              String
  defaultCategoryId String?   @map("default_category_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultCategory    Category?           @relation(fields: [defaultCategoryId], references: [id])
  recurringTemplates RecurringTemplate[]
  installmentPlans   InstallmentPlan[]
  transactions       Transaction[]

  // Nome único por usuário, sem diferenciar maiúsculas: índice parcial em lower(name) no SQL.
  @@index([userId])
  @@map("payees")
}

/// Modelos que projetam lançamentos nos meses (salário base, contas fixas).
/// Cada modelo gera um lançamento previsto por mês em que ocorre (RF-11).
model RecurringTemplate {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  /// income · expense
  type          String
  /// fixed · planned
  nature        String
  description   String
  amountCents   BigInt    @map("amount_cents")
  categoryId    String?   @map("category_id") @db.Uuid
  accountId     String?   @map("account_id") @db.Uuid
  payeeId       String?   @map("payee_id") @db.Uuid
  /// pix · debit · credit · cash · boleto · transfer · other
  paymentMethod String?   @map("payment_method")
  creditCardId  String?   @map("credit_card_id") @db.Uuid
  /// monthly · yearly
  frequency     String
  monthOfYear   Int?      @map("month_of_year") @db.SmallInt
  dayOfMonth    Int       @map("day_of_month") @db.SmallInt
  startMonth    DateTime  @map("start_month") @db.Date
  endMonth      DateTime? @map("end_month") @db.Date
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category?   @relation(fields: [categoryId], references: [id])
  account    Account?    @relation(fields: [accountId], references: [id])
  payee      Payee?      @relation(fields: [payeeId], references: [id])
  creditCard CreditCard? @relation(fields: [creditCardId], references: [id])

  transactions Transaction[]

  @@index([userId])
  @@map("recurring_templates")
}

// ─── Finanças (Fase 2) ──────────────────────────────────────────────────────

/// Uma compra parcelada (ex.: Nintendo Switch 12×). As parcelas são transactions.
model InstallmentPlan {
  id                   String    @id @default(uuid(7)) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  description          String
  payeeId              String?   @map("payee_id") @db.Uuid
  categoryId           String?   @map("category_id") @db.Uuid
  /// null se parcelado em boleto/carnê.
  creditCardId         String?   @map("credit_card_id") @db.Uuid
  accountId            String?   @map("account_id") @db.Uuid
  /// pix · debit · credit · cash · boleto · transfer · other
  paymentMethod        String    @map("payment_method")
  purchaseDate         DateTime  @map("purchase_date") @db.Date
  totalCents           BigInt    @map("total_cents")
  installmentsCount    Int       @map("installments_count") @db.SmallInt
  firstCompetenceMonth DateTime  @map("first_competence_month") @db.Date
  /// active · paid_off · canceled
  status               String    @default("active")
  paidOffAt            DateTime? @map("paid_off_at") @db.Date
  /// Desconto obtido na quitação antecipada (RF-46): falta pagar − valor pago.
  payoffDiscountCents  BigInt?   @map("payoff_discount_cents")
  notes                String?
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payee        Payee?        @relation(fields: [payeeId], references: [id])
  category     Category?     @relation(fields: [categoryId], references: [id])
  creditCard   CreditCard?   @relation(fields: [creditCardId], references: [id])
  account      Account?      @relation(fields: [accountId], references: [id])
  transactions Transaction[]

  @@index([userId, status])
  @@map("installment_plans")
}

/// Toda linha do mês: receitas, despesas, parcelas, planejamentos.
model Transaction {
  id                  String    @id @default(uuid(7)) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  /// income · expense
  type                String
  /// fixed · variable · planned · installment · extra
  nature              String
  /// forecast · settled
  status              String
  description         String
  /// Sempre positivo; o sinal vem do tipo.
  amountCents         BigInt    @map("amount_cents")
  competenceMonth     DateTime  @map("competence_month") @db.Date
  date                DateTime  @db.Date
  categoryId          String?   @map("category_id") @db.Uuid
  accountId           String?   @map("account_id") @db.Uuid
  payeeId             String?   @map("payee_id") @db.Uuid
  /// pix · debit · credit · cash · boleto · transfer · other
  paymentMethod       String?   @map("payment_method")
  creditCardId        String?   @map("credit_card_id") @db.Uuid
  recurringTemplateId String?   @map("recurring_template_id") @db.Uuid
  installmentPlanId   String?   @map("installment_plan_id") @db.Uuid
  /// 1..N; null na transação de quitação antecipada.
  installmentNumber   Int?      @map("installment_number") @db.SmallInt
  /// Gasto vinculado a um planejamento (RF-22).
  parentPlannedId     String?   @map("parent_planned_id") @db.Uuid
  /// Editado à mão depois de gerado por modelo/parcelamento (RF-12, RF-47).
  isOverride          Boolean   @default(false) @map("is_override")
  tags                String[]  @default([])
  notes               String?
  /// manual · import · template · plan · bot
  source              String    @default("manual")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(3)

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category          Category?          @relation(fields: [categoryId], references: [id])
  account           Account?           @relation(fields: [accountId], references: [id])
  payee             Payee?             @relation(fields: [payeeId], references: [id])
  creditCard        CreditCard?        @relation(fields: [creditCardId], references: [id])
  recurringTemplate RecurringTemplate? @relation(fields: [recurringTemplateId], references: [id])
  installmentPlan   InstallmentPlan?   @relation(fields: [installmentPlanId], references: [id])
  parentPlanned     Transaction?       @relation("PlannedChildren", fields: [parentPlannedId], references: [id])
  plannedChildren   Transaction[]      @relation("PlannedChildren")

  // Índices únicos (modelo × mês, parcelamento × parcela) e CHECKs ficam no SQL da migration.
  @@index([userId, competenceMonth])
  @@index([userId, installmentPlanId])
  @@index([userId, creditCardId, competenceMonth])
  @@index([userId, payeeId])
  @@index([parentPlannedId])
  @@map("transactions")
}

/// Ajustes de um mês: meta de investimento do mês (RF-50) e observações.
model MonthSettings {
  userId            String    @map("user_id") @db.Uuid
  competenceMonth   DateTime  @map("competence_month") @db.Date
  /// null = usa a meta padrão do usuário.
  savingsGoalCents  BigInt?   @map("savings_goal_cents")
  /// Quanto da meta já foi investido no mês (a meta funciona como uma conta). null = nada.
  goalInvestedCents BigInt?   @map("goal_invested_cents")
  notes             String?
  closedAt          DateTime? @map("closed_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, competenceMonth])
  @@map("month_settings")
}

// ─── Importação (docs/08 › RI-03) ────────────────────────────────────────────

/// Uma importação de arquivo. Guarda o mapeamento (reaproveitado na próxima) e permite desfazer.
model ImportJob {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  /// transactions · installments · monthly_sheet
  kind        String
  fileName    String    @map("file_name")
  mapping     Json?
  /// pending · committed · undone
  status      String    @default("pending")
  stats       Json?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  committedAt DateTime? @map("committed_at") @db.Timestamptz(3)
  undoneAt    DateTime? @map("undone_at") @db.Timestamptz(3)

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  rows ImportRow[]

  @@index([userId, createdAt])
  @@map("import_jobs")
}

/// Linha importada (ou cadastro criado pela importação, com row_number 0): o que veio do arquivo,
/// o rascunho validado e o que foi gravado — base do "desfazer importação".
model ImportRow {
  id         String  @id @default(uuid(7)) @db.Uuid
  jobId      String  @map("job_id") @db.Uuid
  rowNumber  Int     @map("row_number")
  raw        Json?
  parsed     Json?
  errors     Json?
  /// transaction · installment_plan · month_settings · account · category · payee
  entityType String? @map("entity_type")
  entityId   String? @map("entity_id") @db.Uuid

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("import_rows")
}

// ─── Carteira (docs/03 › Investimentos, docs/05) ─────────────────────────────

/// Classe de ativo (RC-01/02): Renda Fixa/Reserva, FIIs, Ações, Exterior, Cripto.
model AssetClass {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  name      String
  /// fixed_income · reit · stock · etf · international · crypto · other
  kind      String
  color     String
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets           Asset[]
  targetAllocation TargetAllocation?

  @@index([userId])
  @@map("asset_classes")
}

/// Meta de alocação por classe (soma 100%, validada no core como aviso).
model TargetAllocation {
  assetClassId String   @id @map("asset_class_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  targetPct    Decimal  @map("target_pct") @db.Decimal(7, 4)
  /// Teto de alerta da classe (opcional).
  maxPct       Decimal? @map("max_pct") @db.Decimal(7, 4)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetClass AssetClass @relation(fields: [assetClassId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("target_allocations")
}

/// Ativo (RC-10..13). Mesmo ticker em duas corretoras = dois ativos.
model Asset {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  assetClassId     String    @map("asset_class_id") @db.Uuid
  /// "ITSA4", "MXRF11" — null para renda fixa.
  ticker           String?
  name             String
  /// Corretora/banco de custódia.
  accountId        String?   @map("account_id") @db.Uuid
  /// auto (cotação do provedor) · manual (valor informado)
  quoteMode        String    @default("auto") @map("quote_mode")
  /// { indexer, rate, maturity, liquidity } para renda fixa.
  fixedIncomeInfo  Json?     @map("fixed_income_info")
  targetWeightPct  Decimal?  @map("target_weight_pct") @db.Decimal(7, 4)
  maxWeightPct     Decimal?  @map("max_weight_pct") @db.Decimal(7, 4)
  /// Preço informado à mão (vale quando é mais recente que a cotação, RC-33).
  manualPrice      Decimal?  @map("manual_price") @db.Decimal(20, 8)
  manualPriceAt    DateTime? @map("manual_price_at") @db.Timestamptz(3)
  /// Saldo informado (renda fixa) até existir o balanço mensal (Fase 7).
  manualValueCents BigInt?   @map("manual_value_cents")
  manualValueAt    DateTime? @map("manual_value_at") @db.Timestamptz(3)
  isArchived       Boolean   @default(false) @map("is_archived")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetClass AssetClass   @relation(fields: [assetClassId], references: [id])
  account    Account?     @relation(fields: [accountId], references: [id])
  trades     AssetTrade[]
  dividends  Dividend[]

  @@index([userId])
  @@index([ticker])
  @@map("assets")
}

/// Operação (RC-20/21): compra, venda, bonificação, desdobramento, renda fixa.
model AssetTrade {
  id                 String    @id @default(uuid(7)) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  assetId            String    @map("asset_id") @db.Uuid
  /// buy · sell · bonus · split · reverse_split · subscription · fixed_income_deposit · fixed_income_withdrawal
  kind               String
  tradeDate          DateTime  @map("trade_date") @db.Date
  quantity           Decimal   @db.Decimal(20, 8)
  unitPrice          Decimal   @map("unit_price") @db.Decimal(20, 8)
  feesCents          BigInt    @default(0) @map("fees_cents")
  totalCents         BigInt    @map("total_cents")
  splitRatio         Decimal?  @map("split_ratio") @db.Decimal(20, 8)
  /// Simulação de aporte efetivada (Fase 6).
  contributionPlanId String?   @map("contribution_plan_id") @db.Uuid
  notes              String?
  /// manual · import
  source             String    @default("manual")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id])

  @@index([userId, tradeDate])
  @@index([assetId])
  @@map("asset_trades")
}

/// Provento (RC-40): dividendo, JCP, rendimento de FII, juros. Não é aporte (RC-42).
model Dividend {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  assetId      String    @map("asset_id") @db.Uuid
  /// dividend · jcp · income · interest · other
  kind         String
  payDate      DateTime  @map("pay_date") @db.Date
  exDate       DateTime? @map("ex_date") @db.Date
  /// Valor líquido recebido.
  amountCents  BigInt    @map("amount_cents")
  grossCents   BigInt?   @map("gross_cents")
  quantityBase Decimal?  @map("quantity_base") @db.Decimal(20, 8)
  perShare     Decimal?  @map("per_share") @db.Decimal(20, 8)
  notes        String?
  source       String    @default("manual")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id])

  @@index([userId, payDate])
  @@index([assetId])
  @@map("dividends")
}

/// Cache global de cotações (RC-31): um registro por ticker.
model QuoteCache {
  ticker    String    @id
  price     Decimal?  @db.Decimal(20, 8)
  changePct Decimal?  @map("change_pct") @db.Decimal(12, 6)
  name      String?
  /// Momento da cotação no provedor.
  quotedAt  DateTime? @map("quoted_at") @db.Timestamptz(3)
  fetchedAt DateTime  @map("fetched_at") @db.Timestamptz(3)
  source    String
  /// Última falha (não tenta de novo antes do intervalo de espera).
  errorAt   DateTime? @map("error_at") @db.Timestamptz(3)
  error     String?

  @@map("quotes_cache")
}

/// Cache genérico de respostas do provedor (ex.: lista de tickers), por chave.
model ProviderCache {
  key       String   @id
  payload   Json
  fetchedAt DateTime @map("fetched_at") @db.Timestamptz(3)

  @@map("provider_cache")
}

/// Chamadas feitas ao provedor por mês (orçamento com parada, RC-32).
model ProviderUsage {
  provider  String
  month     String
  calls     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([provider, month])
  @@map("provider_usage")
}

/// Relato de bug ou sugestão de melhoria enviado pelo app (docs/15). Fica do nosso lado para
/// o dono triar e a fila de agentes resolver. O texto é do usuário: dado, nunca instrução.
model Feedback {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  /// bug · improvement
  kind            String
  title           String
  description     String
  /// Tela onde o usuário estava (ex.: /carteira/ativos/:id).
  page            String?
  /// Versão do app, navegador, tamanho da tela e tema (diagnóstico).
  context         Json?
  /// pending · approved · in_progress · review · done · rejected
  status          String    @default("pending")
  /// low · medium · high (definida pelo dono)
  priority        String?
  /// Nota do dono (triagem, critério de aceite, motivo da recusa). Aparece para quem enviou.
  ownerNote       String?   @map("owner_note")
  /// Registro do agente: o que fez, o que ficou de fora.
  agentNotes      String?   @map("agent_notes")
  branch          String?
  commitSha       String?   @map("commit_sha")
  statusChangedAt DateTime  @default(now()) @map("status_changed_at") @db.Timestamptz(3)
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events FeedbackEvent[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("feedback")
}

/// Histórico de um relato: mudanças de status e notas, de quem (owner · agent · user).
model FeedbackEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  feedbackId String   @map("feedback_id") @db.Uuid
  actor      String
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId, createdAt])
  @@map("feedback_events")
}

// ─── Aporte (Fase 6, docs/06) ───────────────────────────────────────────────

/// Simulação de aporte (o "carrinho"). Rascunho salvo sozinho; efetivar cria as compras.
model ContributionPlan {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  competenceMonth DateTime  @map("competence_month") @db.Date
  name            String
  totalCents      BigInt    @map("total_cents")
  /// draft · executed · discarded
  status          String    @default("draft")
  /// { assetClassId: pct } (pct em texto decimal, soma 100)
  classSplit      Json      @map("class_split")
  /// A simulação principal do mês (RA-30).
  isPrimary       Boolean   @default(false) @map("is_primary")
  executedAt      DateTime? @map("executed_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  user  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ContributionPlanItem[]

  @@index([userId, competenceMonth])
  @@map("contribution_plans")
}

/// Item da simulação. Ativo novo (RA-11) fica em new_asset até a efetivação criar o ativo.
model ContributionPlanItem {
  id              String    @id @default(uuid(7)) @db.Uuid
  planId          String    @map("plan_id") @db.Uuid
  assetId         String?   @map("asset_id") @db.Uuid
  /// { ticker, name, assetClassId } para ativo que ainda não existe.
  newAsset        Json?     @map("new_asset")
  /// by_value · by_quantity
  mode            String
  quantity        Decimal   @db.Decimal(20, 8)
  unitPrice       Decimal   @map("unit_price") @db.Decimal(20, 8)
  valueCents      BigInt    @map("value_cents")
  sortOrder       Int       @default(0) @map("sort_order")
  /// Efetivação parcial (RA-32): a compra criada para este item.
  executedTradeId String?   @map("executed_trade_id") @db.Uuid
  executedAt      DateTime? @map("executed_at") @db.Timestamptz(3)

  plan ContributionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, sortOrder])
  @@map("contribution_plan_items")
}

/// Aporte externo: dinheiro novo que entra na carteira (base da rentabilidade real, Fase 7).
model Contribution {
  id                 String    @id @default(uuid(7)) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  date               DateTime  @db.Date
  competenceMonth    DateTime  @map("competence_month") @db.Date
  /// Negativo = resgate para fora da carteira.
  amountCents        BigInt    @map("amount_cents")
  accountId          String?   @map("account_id") @db.Uuid
  notes              String?
  contributionPlanId String?   @map("contribution_plan_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, competenceMonth])
  @@map("contributions")
}
