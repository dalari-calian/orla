# Copie para .env (o .env nunca vai para o Git).

# Banco local (docker compose). 5433 para não conflitar com outro Postgres na 5432.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://orla:orla@localhost:5433/orla?schema=public

# API
API_PORT=3333
APP_TIMEZONE=America/Sao_Paulo

# Auth (usados a partir da Fase 1) — troque por valores longos e aleatórios.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
REFRESH_TOKEN_PEPPER=troque-por-outro-segredo-longo
SIGNUP_MODE=invite
SIGNUP_INVITE_CODE=orla-convite

# Cotações (só a partir da Fase 5 — Carteira)
# BRAPI_TOKEN=
