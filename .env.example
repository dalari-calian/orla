# Copie para .env (o .env nunca vai para o Git).

# Banco local (docker compose). 5433 para não conflitar com outro Postgres na 5432.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://orla:orla@localhost:5433/orla?schema=public

# API
API_PORT=3333
APP_TIMEZONE=America/Sao_Paulo
# Endereço do front (checagem de CSRF nas escritas)
APP_ORIGIN=http://localhost:5173

# Auth (usados a partir da Fase 1) — troque por valores longos e aleatórios.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
REFRESH_TOKEN_PEPPER=troque-por-outro-segredo-longo
SIGNUP_MODE=invite
SIGNUP_INVITE_CODE=orla-convite

# Cotações (Fase 5 — Carteira). Crie o token grátis em https://brapi.dev e cole aqui.
# Sem token, a carteira funciona com preço manual. Nunca versione o token.
# BRAPI_TOKEN=
# Orçamento de chamadas ao provedor por mês (para ao atingir).
QUOTES_MONTHLY_BUDGET=13000
# Segredo do cron diário de cotações (GET /api/v1/jobs/quotes com Authorization: Bearer ...).
# CRON_SECRET=
